  "type": "software",
  "title": "Source-traceable continuous morphology of selected Voynich writing: frozen evidence contribution",
  "authors": [
    {
      "given-names": "Dylan",
      "family-names": "Bedford",
      "orcid": "https://orcid.org/0009-0005-9766-224X"
    }
  ],
  "abstract": "A source-derived, class-free continuous contour/morphology representation of selected confirmed writing, retaining uncertain whole-parent extents and alternative raster recoveries. Includes the earlier structural/sequence/feature experiments and their negative results. Not a transcription or decipherment.",
